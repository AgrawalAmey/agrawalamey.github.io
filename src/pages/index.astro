---
import Layout from '@layouts/Layout.astro'
import { getSortedPosts } from '@utils'
import { getCollection, render } from 'astro:content'
import PostPreview from '@components/PostPreview.astro'
import ProjectListing from '@components/ProjectListing.astro'
import FeaturedProject from '@components/FeaturedProject.astro'
import Pagination from '@components/Pagination.astro'
import BlockHeader from '@components/BlockHeader.astro'
import HomeBanner from '@components/HomeBanner.astro'
import siteConfig from '../site.config'

const home = await getCollection('home')
let HomeContent
let homeAvatarImage
let homeGithubCalendar
if (home.length > 0) {
  const homeEntry = home[0]
  const { Content } = await render(homeEntry)
  HomeContent = Content
  homeAvatarImage = homeEntry.data.avatarImage
  homeGithubCalendar = homeEntry.data.githubCalendar
}
const sortedPosts = await getSortedPosts()
const projects = await getCollection('projects', ({ data }) => !data.draft)
const sortedProjects = projects.sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
)
const featuredProjectOrder = ['sarathi-serve', 'vidur', 'medha', 'revati']
const featuredNames: Record<string, string> = {
  'sarathi-serve': 'Sarathi-Serve',
  vidur: 'Vidur',
  medha: 'Medha',
  revati: 'Revati',
}
const featuredProjects = featuredProjectOrder
  .map((id) => projects.find((project) => project.id === id))
  .filter((project): project is (typeof projects)[number] => Boolean(project))
const featuredIds = new Set(featuredProjectOrder)
const archiveProjects = sortedProjects.filter((project) => !featuredIds.has(project.id))
---

<Layout>
  {
    HomeContent && (
      <HomeBanner avatarImage={homeAvatarImage}>
        <HomeContent />
      </HomeBanner>
    )
  }

  <section id="selected-systems" aria-labelledby="selected-systems-heading">
    <BlockHeader><span id="selected-systems-heading">selected research</span></BlockHeader
    >
    <p class="section-intro">
      Selected work across scheduling, capacity planning, long-context serving, and
      emulation.
    </p>
    <div class="featured-projects">
      {
        featuredProjects.map((project) => (
          <FeaturedProject
            project={project}
            name={featuredNames[project.id]}
          />
        ))
      }
    </div>
  </section>

  <section aria-labelledby="research-archive-heading">
    <BlockHeader><span id="research-archive-heading">all publications</span></BlockHeader>
    <div class="all-projects">
      {archiveProjects.map((project) => <ProjectListing project={project} />)}
    </div>
  </section>

  <script is:inline>
    ;(() => {
      if (!('IntersectionObserver' in window)) return
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
      // Only content below the fold animates; what's on screen at load stays put.
      const targets = [
        ...document.querySelectorAll(
          'main section > h1, .section-intro, .featured-project, .project-item',
        ),
      ].filter((el) => el.getBoundingClientRect().top > window.innerHeight)
      targets.forEach((el) => el.setAttribute('data-reveal', ''))
      const observer = new IntersectionObserver(
        (entries) => {
          entries
            .filter((entry) => entry.isIntersecting)
            .forEach((entry, i) => {
              entry.target.style.setProperty('--reveal-delay', `${Math.min(i, 4) * 50}ms`)
              entry.target.setAttribute('data-reveal', 'in')
              observer.unobserve(entry.target)
            })
        },
        { rootMargin: '0px 0px -8% 0px' },
      )
      targets.forEach((el) => observer.observe(el))
    })()
  </script>
</Layout>

<style>
  section {
    scroll-margin-top: 1.5rem;
  }

  .section-intro {
    max-width: 42rem;
    margin: -0.25rem 0 1.25rem;
    color: var(--theme-foreground);
    font-size: var(--fs-body);
    line-height: 1.65;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .featured-projects {
    display: flex;
    flex-direction: column;
    margin: 1.25rem 0 2.5rem;
  }

  .all-projects {
    margin: 1.5rem 0;
  }
</style>

<style is:global>
  [data-reveal] {
    transition-property: opacity, translate;
    transition-duration: 0.35s;
    transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  /* !important beats component opacity rules; it drops away once revealed. */
  [data-reveal=''] {
    opacity: 0 !important;
    translate: 0 0.25rem;
  }

  a.heading-anchor {
    display: none !important;
  }
</style>
