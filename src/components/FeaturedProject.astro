---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  name: string
}

const { project, name } = Astro.props
const { title, venue, description, links } = project.data
const primaryUrl = links?.pdf || links?.website || links?.code
---

<article class="featured-project">
  <div class="featured-head">
    <h3>
      {
        primaryUrl ? (
          <a
            href={primaryUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title}
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>
    {venue && <span class="featured-venue">{venue}</span>}
  </div>
  {description && <p>{description}</p>}
  {
    links && (
      <div class="featured-links" aria-label={`Links for ${title}`}>
        {links.pdf && (
          <a href={links.pdf} target="_blank" rel="noopener noreferrer">
            [paper]
          </a>
        )}
        {links.code && (
          <a href={links.code} target="_blank" rel="noopener noreferrer">
            [code]
          </a>
        )}
        {links.video && (
          <a href={links.video} target="_blank" rel="noopener noreferrer">
            [talk]
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .featured-project {
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--theme-foreground) 14%, transparent);
  }

  .featured-project:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--theme-foreground) 14%, transparent);
  }

  .featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    margin: 0;
    color: var(--theme-foreground);
    font-size: var(--fs-title);
    font-weight: 650;
    line-height: 1.45;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-project:hover h3 a,
  h3 a:focus-visible {
    color: var(--theme-accent);
  }

  .featured-venue {
    flex-shrink: 0;
    color: var(--theme-foreground);
    font-size: var(--fs-meta);
    opacity: 0.58;
    transition: opacity 0.2s ease;
  }

  .featured-project:hover .featured-venue {
    opacity: 0.85;
  }

  p {
    max-width: 35rem;
    margin: 0.3rem 0 0;
    color: var(--theme-foreground);
    font-size: var(--fs-body);
    line-height: 1.6;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-top: 0.15rem;
  }

  /* Vertical padding keeps a 40px hit area; the negative margin keeps rows compact. */
  .featured-links a {
    padding: 0.65rem 0;
    margin: -0.4rem 0 -0.65rem;
    color: var(--theme-accent);
    font-size: var(--fs-meta);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-links a:hover {
    color: var(--theme-foreground);
  }
</style>
