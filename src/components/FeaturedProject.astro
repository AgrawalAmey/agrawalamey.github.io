---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  eyebrow: string
  name: string
}

const { project, eyebrow, name } = Astro.props
const { title, venue, description, links } = project.data
const primaryUrl = links?.pdf || links?.website || links?.code
---

<article class="featured-project">
  <div class="featured-meta">
    <span class="research-area">{eyebrow}</span>
    {venue && <span>{venue}</span>}
  </div>
  <div class="featured-body">
    <h3>
      {
        primaryUrl ? (
          <a
            href={primaryUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={title}
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>
    {description && <p>{description}</p>}
    {
      links && (
        <div class="featured-links" aria-label={`Links for ${title}`}>
          {links.pdf && (
            <a href={links.pdf} target="_blank" rel="noopener noreferrer">
              Paper
            </a>
          )}
          {links.code && (
            <a href={links.code} target="_blank" rel="noopener noreferrer">
              Code
            </a>
          )}
          {links.video && (
            <a href={links.video} target="_blank" rel="noopener noreferrer">
              Talk
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .featured-project {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.2rem 0;
    border-top: 1px solid color-mix(in srgb, var(--theme-foreground) 14%, transparent);
  }

  .featured-project:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--theme-foreground) 14%, transparent);
  }

  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.15rem;
    color: var(--theme-foreground);
    font-size: 0.72rem;
    line-height: 1.5;
    opacity: 0.58;
  }

  .research-area {
    color: var(--theme-accent);
    font-weight: 650;
    opacity: 1;
  }

  h3 {
    margin: 0;
    color: var(--theme-foreground);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.45;
    text-wrap: balance;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--theme-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  p {
    max-width: 35rem;
    margin: 0.45rem 0 0.6rem;
    color: var(--theme-foreground);
    font-size: 0.82rem;
    line-height: 1.6;
    opacity: 0.7;
    text-wrap: pretty;
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .featured-links a {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    color: var(--theme-accent);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
  }

  .featured-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 520px) {
    .featured-project {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .featured-meta {
      flex-direction: row;
      gap: 0.65rem;
    }
  }
</style>
