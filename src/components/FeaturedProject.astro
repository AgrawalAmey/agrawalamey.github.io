---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  eyebrow: string
  name: string
}

const { project, eyebrow, name } = Astro.props
const { title, venue, description, links } = project.data
const primaryUrl = links?.pdf || links?.website || links?.code
---

<article class="featured-project">
  <div class="featured-meta">
    <span>{eyebrow}</span>
    {venue && <span class="featured-venue">{venue}</span>}
  </div>
  <h3>
    {
      primaryUrl ? (
        <a href={primaryUrl} target="_blank" rel="noopener noreferrer" aria-label={title}>
          {name}
        </a>
      ) : (
        name
      )
    }
  </h3>
  {description && <p>{description}</p>}
  {
    links && (
      <div class="featured-links" aria-label={`Links for ${title}`}>
        {links.pdf && (
          <a href={links.pdf} target="_blank" rel="noopener noreferrer">
            Paper ↗
          </a>
        )}
        {links.code && (
          <a href={links.code} target="_blank" rel="noopener noreferrer">
            Code ↗
          </a>
        )}
        {links.video && (
          <a href={links.video} target="_blank" rel="noopener noreferrer">
            Talk ↗
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .featured-project {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--theme-foreground) 12%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--theme-background) 96%, var(--theme-accent) 4%);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 12px 30px rgb(0 0 0 / 0.06);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .featured-project:hover {
    border-color: color-mix(in srgb, var(--theme-accent) 45%, transparent);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.1),
      0 16px 36px rgb(0 0 0 / 0.09);
    transform: translateY(-2px);
  }

  .featured-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--theme-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .featured-venue {
    color: var(--theme-foreground);
    opacity: 0.6;
  }

  h3 {
    margin: 1rem 0 0;
    color: var(--theme-foreground);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.45;
    text-wrap: balance;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--theme-accent);
  }

  p {
    margin: 0.75rem 0 1rem;
    color: var(--theme-foreground);
    font-size: 0.82rem;
    line-height: 1.55;
    opacity: 0.72;
    text-wrap: pretty;
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .featured-links a {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    color: var(--theme-accent);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  .featured-links a:hover {
    text-decoration: underline;
  }

  .featured-links a:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-project {
      transition: none;
    }

    .featured-project:hover {
      transform: none;
    }
  }
</style>
