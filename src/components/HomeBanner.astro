---
import ReactGithubCalendar from './ReactGithubCalendar'
import type { FrontmatterImage } from '../types'

interface Props {
  avatarImage?: FrontmatterImage
  githubCalendar?: string
}

const { githubCalendar } = Astro.props
---

<section class="profile-intro">
  <div class="profile-content prose prose-sm sm:prose-base max-w-none">
    <slot />
  </div>
  {
    githubCalendar && (
      <div class="github-section">
        <p class="section-label">Recent activity</p>
        <div class="h-42">
          <ReactGithubCalendar username={githubCalendar} client:only />
        </div>
      </div>
    )
  }
</section>

<style>
  .profile-intro {
    margin: 2rem 0 2.75rem;
    font-family: var(--theme-font);
  }

  .github-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--theme-foreground) 14%, transparent);
  }

  .section-label {
    margin: 0 0 1rem;
    color: var(--theme-foreground);
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0.65;
  }
</style>

<style is:global>
  .github-calendar rect {
    stroke: var(--theme-foreground) !important;
    stroke-opacity: 0.1 !important;
  }

  .profile-content p {
    margin: 0.8rem 0;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .profile-content a {
    color: var(--theme-a);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .profile-content a:hover {
    color: var(--theme-accent);
  }

  .profile-content .intro-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 116px;
    gap: 2rem;
    align-items: start;
    margin-bottom: 1.25rem;
  }

  .profile-content .founder-headline {
    display: block;
    max-width: 35rem;
    margin: 0;
    color: var(--theme-foreground);
    font-size: clamp(1.65rem, 4vw, 2.15rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .profile-content .founder-headline::before {
    content: none;
  }

  .profile-content .founder-deck {
    max-width: 35rem;
    margin: 1rem 0 0;
    color: var(--theme-foreground);
    font-size: 0.98rem;
    line-height: 1.65;
    opacity: 0.78;
  }

  .profile-content .intro-image {
    width: 116px;
    height: 116px;
    border-radius: 0.35rem;
    object-fit: cover;
    opacity: 0.96;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .profile-content .founder-bio {
    max-width: 43rem;
    color: var(--theme-foreground);
    font-size: 0.9rem;
    opacity: 0.84;
  }

  .profile-content .current-work {
    max-width: 43rem;
    color: var(--theme-foreground);
    font-size: 0.88rem;
    opacity: 0.78;
  }

  .profile-content .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-top: 1.2rem;
    font-size: 0.82rem;
  }

  .profile-content .profile-links a {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    color: var(--theme-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .profile-content .profile-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .profile-intro {
      margin-top: 1.5rem;
    }

    .profile-content .intro-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .profile-content .intro-image {
      grid-row: 1;
      width: 96px;
      height: 96px;
    }

    .profile-content .founder-headline {
      font-size: 1.65rem;
    }
  }
</style>
